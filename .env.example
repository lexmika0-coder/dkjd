# Database Connection (Required for production)
# Get this from your Neon dashboard: https://neon.tech
DATABASE_URL=postgresql://user:password@host/database

# Telegram Bot Configuration (Optional - for visitor notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Frontend API URL (Only needed if frontend and backend are on different domains)
# Leave empty if running on the same domain
VITE_API_URL=https://your-backend-url.com
